{$MONITOR_DOMAIN} {
  @compressed not path /oanda-quotes
  encode @compressed zstd gzip
  handle /oanda-quotes {
    reverse_proxy monitor:8787 {
      flush_interval -1
    }
  }
  @allowed path /health /snapshot /market-research /oanda-research /oanda-candles
  handle @allowed {
    reverse_proxy monitor:8787
  }
  handle {
    respond "Not found" 404
  }
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "no-referrer"
  }
}
