# Copy to .env *on your private VPS only*. Replace example hostname with YOUR real DNS name.
MONITOR_DOMAIN=monitor.example.com
POLL_MS=300000
MONITOR_TARGETS=crypto:BTCUSDT:15,crypto:ETHUSDT:15,metals:XAUUSD:15,forex:EURUSD:15

# Optional verified calendar feed. Without it news checks stay blocked.
# Must return JSON events with explicit UTC/offset timestamps; see README_AR.md.
ECONOMIC_FEED_URL=
MAX_STOP_DISTANCE_PCT=5

# Optional licensed execution-quote feed; must return an HTTPS JSON object with quotes[].
QUOTE_FEED_URL=
QUOTE_MAX_AGE_MS=30000
QUOTE_MAX_SPREAD_BPS=40
